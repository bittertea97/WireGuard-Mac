#!/bin/bash
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage:
  wireguard-cli check <config.conf>
  wireguard-cli up <config.conf>
  wireguard-cli down <config.conf>
  wireguard-cli status <config.conf>

The config is read in place and is never copied into the repository.
Run up/down as root, for example:
  sudo scripts/wireguard-cli up /path/to/tunnel.conf
EOF
    exit 2
}

die() {
    printf 'wireguard-cli: %s\n' "$1" >&2
    exit 1
}

command -v wg-quick >/dev/null 2>&1 || die "wg-quick was not found; install wireguard-tools first"
command -v wg >/dev/null 2>&1 || die "wg was not found; install wireguard-tools first"

check_config() {
    local file="$1"
    awk '
        function trim(s) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s }
        BEGIN { section=""; interfaces=0; peers=0; private_keys=0; peer_keys=0; malformed=0 }
        {
            line=$0
            sub(/[[:space:]]*#.*/, "", line)
            if (line ~ /^[[:space:]]*$/) next
            if (line ~ /^[[:space:]]*\[Interface\][[:space:]]*$/) { section="interface"; interfaces++; next }
            if (line ~ /^[[:space:]]*\[Peer\][[:space:]]*$/) { section="peer"; peers++; next }
            if (line !~ /^[[:space:]]*[A-Za-z][A-Za-z0-9]*[[:space:]]*=/) { malformed=1; next }
            split(line, pair, "=")
            key=trim(pair[1])
            if (section == "interface" && key == "PrivateKey") private_keys++
            if (section == "peer" && key == "PublicKey") peer_keys++
        }
        END {
            if (interfaces != 1 || peers < 1 || private_keys != 1 || peer_keys != peers || malformed) exit 1
        }
    ' "$file" || die "configuration syntax is invalid"
}

find_runtime_interface() {
    local expected_public_key candidate actual_public_key

    expected_public_key=$(
        awk '
            /^[[:space:]]*PrivateKey[[:space:]]*=/ {
                sub(/^[^=]*=[[:space:]]*/, "")
                sub(/[[:space:]]+#.*$/, "")
                print
                exit
            }
        ' "$config" | wg pubkey
    ) || return 1
    [[ -n "$expected_public_key" ]] || return 1

    for candidate in $(wg show interfaces); do
        actual_public_key=$(wg show "$candidate" public-key 2>/dev/null) || continue
        if [[ "$actual_public_key" == "$expected_public_key" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

action=${1:-}
config=${2:-}
[[ -n "$action" && -n "$config" ]] || usage
[[ -f "$config" ]] || die "configuration file not found"

config=$(cd "$(dirname "$config")" && pwd)/$(basename "$config")
interface=$(basename "$config")
interface=${interface%.conf}
[[ "$interface" != "$config" && "$interface" =~ ^[A-Za-z0-9_.-]+$ ]] || die "configuration filename must end in .conf"

case "$action" in
    check)
        check_config "$config"
        printf 'Configuration syntax is valid: %s\n' "$interface"
        ;;
    up)
        [[ "$EUID" -eq 0 ]] || die "up must be run with sudo"
        wg-quick up "$config"
        ;;
    down)
        [[ "$EUID" -eq 0 ]] || die "down must be run with sudo"
        wg-quick down "$config"
        ;;
    status)
        [[ "$EUID" -eq 0 ]] || die "status must be run with sudo to inspect WireGuard interfaces"
        runtime_interface=$(find_runtime_interface) || {
            printf 'Tunnel is down: %s\n' "$interface"
            exit 1
        }
        printf 'Tunnel is up: %s (%s)\n' "$interface" "$runtime_interface"
        wg show "$runtime_interface"
        ;;
    *)
        usage
        ;;
esac
